---
import BaseLayout from '../layouts/BaseLayout.astro';
import { STUDIO_CONFIG } from '../data/studio';
---
<BaseLayout title="Music — NiK Studio" active="music">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-12 grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
    <img src={STUDIO_CONFIG.assets.music} alt="Music Cover" class="rounded-2xl aspect-square object-cover border border-white/[0.08]" />
    <div class="md:col-span-2">
      <h1 class="text-3xl font-extrabold text-white">La La Love On My Mind (138 BPM Remix)</h1>
      <p class="mt-2 text-slate-300">Electronic music & 16-bit pixel visualizer project.</p>
      {STUDIO_CONFIG.audio.musicTrack ? (
        <audio controls src={STUDIO_CONFIG.audio.musicTrack} class="mt-5 w-full"></audio>
      ) : (
        <p class="mt-4 text-xs font-mono text-slate-400">Đặt file .mp3/.wav vào public/audio/ và cập nhật src/data/studio.ts</p>
      )}
    </div>
  </section>
</BaseLayout>
