---
import BaseLayout from '../layouts/BaseLayout.astro';
import { STUDIO_CONFIG } from '../data/studio';
---
<BaseLayout title="NiK Studio — Audio DSP & iOS Tools" active="home">
  <section class="relative overflow-hidden border-b border-white/[0.06]">
    <div class="absolute inset-0 opacity-35">
      <img src={STUDIO_CONFIG.assets.hero} alt="NiK Studio" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/80 to-obsidian/40"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-20">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[11px] font-mono bg-cyan-400/10 text-cyan-300 border border-cyan-400/30">
        INDEPENDENT STUDIO • AUDIO DSP & iOS
      </span>
      <h1 class="mt-5 text-3xl sm:text-5xl font-extrabold text-white max-w-3xl leading-tight i18n-text" data-vi="Kiến tạo công cụ âm thanh chính xác & phần mềm iOS tối giản." data-en="Crafting precision audio plugins & minimalist iOS software.">
        Kiến tạo công cụ âm thanh chính xác & phần mềm iOS tối giản.
      </h1>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/vix" class="px-5 py-3 rounded-xl text-sm font-semibold bg-cyan-400 text-slate-950 hover:bg-cyan-300 transition-all i18n-text" data-vi="Khám phá sản phẩm" data-en="Explore Products">Khám phá sản phẩm</a>
        <a href="/contact" class="px-5 py-3 rounded-xl text-sm font-semibold bg-white/[0.05] border border-white/[0.1] text-white hover:border-cyan-400/50 transition-all i18n-text" data-vi="Liên hệ" data-en="Contact">Liên hệ</a>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-14 grid grid-cols-1 md:grid-cols-3 gap-6">
    <a href="/vix" class="rounded-2xl overflow-hidden bg-surface border border-white/[0.08] hover:border-cyan-400/40 transition-all p-4 flex flex-col gap-3">
      <img src={STUDIO_CONFIG.assets.vix} alt="VIX" class="rounded-xl aspect-[4/3] object-cover" />
      <h2 class="text-lg font-bold text-white">VIX / VIX MAX</h2>
      <p class="text-sm text-slate-400">C++ / JUCE & Faust DSP Vocal VST3 Plugin</p>
    </a>
    <a href="/niksign" class="rounded-2xl overflow-hidden bg-surface border border-white/[0.08] hover:border-cyan-400/40 transition-all p-4 flex flex-col gap-3">
      <img src={STUDIO_CONFIG.assets.niksign} alt="NiKSign" class="rounded-xl aspect-[4/3] object-cover" />
      <h2 class="text-lg font-bold text-white">NiKSign iOS</h2>
      <p class="text-sm text-slate-400">On-device IPA signing utility for iPhone</p>
    </a>
    <a href="/music" class="rounded-2xl overflow-hidden bg-surface border border-white/[0.08] hover:border-cyan-400/40 transition-all p-4 flex flex-col gap-3">
      <img src={STUDIO_CONFIG.assets.music} alt="NiK Music" class="rounded-xl aspect-[4/3] object-cover" />
      <h2 class="text-lg font-bold text-white">NiK Music</h2>
      <p class="text-sm text-slate-400">138 BPM Electronic Remixes & Visualizers</p>
    </a>
  </section>
</BaseLayout>
