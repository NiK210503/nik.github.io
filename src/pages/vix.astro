---
import BaseLayout from '../layouts/BaseLayout.astro';
import { STUDIO_CONFIG } from '../data/studio';
---
<BaseLayout title="VIX VST3 — NiK Studio" active="vix">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-12 grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
    <div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white">VIX / VIX MAX — Vocal VST3</h1>
      <p class="mt-3 text-slate-300">C++ / JUCE & Faust DSP vocal processing plugin.</p>
      <div class="mt-6">
        {STUDIO_CONFIG.driveLinks.vix ? (
          <a href={STUDIO_CONFIG.driveLinks.vix} target="_blank" rel="noopener noreferrer" class="inline-block px-5 py-2.5 rounded-xl text-sm font-semibold bg-cyan-400 text-slate-950">Google Drive</a>
        ) : (
          <span class="inline-block px-4 py-2 rounded-xl text-xs font-mono bg-white/[0.05] border border-white/[0.1] text-slate-400">Google Drive link pending in src/data/studio.ts</span>
        )}
      </div>
    </div>
    <img src={STUDIO_CONFIG.assets.vix} alt="VIX" class="rounded-2xl border border-white/[0.08]" />
  </section>
</BaseLayout>
